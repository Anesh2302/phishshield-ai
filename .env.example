# =============================================================================
# PhishShield AI - example environment. Copy to .env and fill in.
# NEVER commit real secrets. Placeholders only.
# =============================================================================

# --- Core ---
ENVIRONMENT=development
LOG_LEVEL=INFO
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_ME_APP_SECRET
# 32-byte urlsafe base64 key for Fernet token encryption.
# Generate with: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=REPLACE_ME_FERNET_KEY

# --- Database ---
POSTGRES_USER=phishshield
POSTGRES_PASSWORD=phishshield
POSTGRES_DB=phishshield
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Full URL overrides the individual values when set.
DATABASE_URL=postgresql+psycopg://phishshield:phishshield@localhost:5432/phishshield

# --- Web / sessions ---
SESSION_COOKIE_NAME=phishshield_session
SESSION_TTL_MINUTES=720
# Comma separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000
# Set to 1 when served over HTTPS so cookies are Secure.
COOKIE_SECURE=0

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_MINUTE=10

# --- Frontend (Next.js) ---
# Must include the /api/v1 suffix; it is inlined into the browser bundle at build time.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
API_INTERNAL_URL=http://localhost:8000

# --- Google / Gmail (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/integrations/gmail/callback
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_VERIFICATION_TOKEN=
GMAIL_ENABLED=0

# --- Microsoft / Outlook (optional) ---
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
MS_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/integrations/outlook/callback
MS_WEBHOOK_CLIENT_STATE=REPLACE_ME_WEBHOOK_STATE
OUTLOOK_ENABLED=0
# Public HTTPS base URL required for Graph change notifications.
PUBLIC_WEBHOOK_BASE_URL=

# --- Threat intelligence (all optional) ---
THREATINTEL_ENABLED=0
VIRUSTOTAL_API_KEY=
URLHAUS_ENABLED=0
PHISHTANK_ENABLED=0

# --- File analysis ---
MAX_UPLOAD_MB=25
UPLOAD_DIR=./storage/uploads
QUARANTINE_DIR=./storage/quarantine
EVIDENCE_DIR=./storage/evidence
FILE_REPUTATION_ENABLED=0

# --- ML ---
ML_MODEL_PATH=./ml/artifacts/url_model.joblib
ML_ENABLED=1

# --- Mock provider test mode (development only) ---
# Enables local fake Gmail/Outlook providers for tests. Never enable in prod.
MOCK_PROVIDERS=0
